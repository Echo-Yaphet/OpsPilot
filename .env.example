OPS_ENV=development
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
# Shared only between the Gateway and the internal restricted Docker proxy.
DOCKER_PROXY_TOKEN=opspilot-local-docker-proxy-token
REDIS_URL=redis://redis:6379/0
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=opspilot
MYSQL_USER=opspilot
MYSQL_PASSWORD=opspilot

# Shared signing key for short-lived, request-bound Control API workload credentials.
# Use a generated secret outside this local development stack.
EXECUTOR_IDENTITY_KEY=opspilot-local-workload-signing-key
EXECUTOR_IDENTITY_TTL_SECONDS=10
EXECUTOR_IDENTITY_MAX_TTL_SECONDS=15

# Optional OpenAI-compatible embedding endpoint. Leave unset for deterministic SQLite retrieval.
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT=10
# SEMANTIC_MINIMUM_SIMILARITY=0.75
