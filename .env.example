OPS_ENV=development
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
# Shared only between the Gateway and the internal restricted Docker proxy.
DOCKER_PROXY_TOKEN=opspilot-local-docker-proxy-token
# Host-published Promtail receiver used by the three Docker syslog drivers.
PROMTAIL_SYSLOG_ADDRESS=tcp://host.docker.internal:1514
# Exact per-service CPU thresholds in host CPU cores; every exporter target is required.
CONTAINER_CPU_THRESHOLDS={"user-service":0.8,"order-service":0.8,"payment-service":0.8}
REDIS_URL=redis://redis:6379/0
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=opspilot
MYSQL_USER=opspilot
MYSQL_PASSWORD=opspilot

# Shared signing key for short-lived, request-bound Control API workload credentials.
# Use a generated secret outside this local development stack.
EXECUTOR_IDENTITY_KEY=opspilot-local-workload-signing-key
EXECUTOR_IDENTITY_KEY_ID=control-api-v1
# During rotation, configure all three values on the Gateway, deploy it first,
# then switch the Control API current key. The Unix timestamp bounds overlap.
# EXECUTOR_IDENTITY_PREVIOUS_KEY_ID=control-api-v0
# EXECUTOR_IDENTITY_PREVIOUS_KEY=replace-with-the-previous-secret
# EXECUTOR_IDENTITY_PREVIOUS_KEY_VALID_UNTIL=1788172800
EXECUTOR_IDENTITY_MAX_ROTATION_OVERLAP_SECONDS=3600
EXECUTOR_IDENTITY_TTL_SECONDS=10
EXECUTOR_IDENTITY_MAX_TTL_SECONDS=15

# Optional OpenAI-compatible embedding endpoint. Leave unset for deterministic SQLite retrieval.
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT=10
# SEMANTIC_MINIMUM_SIMILARITY=0.75

# Verification SLO defaults preserve the original six checks at two-second intervals.
VERIFICATION_MAX_ATTEMPTS=6
VERIFICATION_CHECK_INTERVAL_SECONDS=2
VERIFICATION_SERVICE_HEALTH_CONDITION=healthy
VERIFICATION_DEPENDENCY_METRIC_THRESHOLD=1
VERIFICATION_RECOVERY_STABLE_CHECKS=1
# Partial per-service overrides are merged over the defaults and validated at startup.
# VERIFICATION_SERVICE_POLICIES={"payment-service":{"max_attempts":8,"recovery_stable_checks":2}}
# Optional hot-reload file path. Compose mounts infra/opspilot at /etc/opspilot.
# VERIFICATION_POLICY_FILE=/etc/opspilot/verification-policies.json
# Compatibility mode accepts the legacy unsigned document. Strict signed mode requires a keyring.
# VERIFICATION_POLICY_SIGNING_KEYS={"opspilot-policy-v1":"replace-with-a-secret"}
# VERIFICATION_POLICY_REQUIRE_SIGNATURE=true
# Optional authenticated pull distribution. It requires strict signed mode.
# VERIFICATION_POLICY_DISTRIBUTION_URL=http://policy-distributor:8070/bundle
# VERIFICATION_POLICY_DISTRIBUTION_TOKEN=replace-with-a-distribution-token
# VERIFICATION_POLICY_DISTRIBUTION_TIMEOUT=2
# VERIFICATION_POLICY_DISTRIBUTION_POLL_INTERVAL=2
# VERIFICATION_POLICY_NODE_ID=control-api-primary
# VERIFICATION_POLICY_ROLLOUT_NODES={"control-api-canary":"http://control-api-canary:8080"}
# VERIFICATION_POLICY_ROLLOUT_TIMEOUT=2
# Peer fan-out uses fresh request-bound credentials and never calls the local public status route.
# VERIFICATION_POLICY_PEER_IDENTITY_KEY=replace-with-a-peer-signing-secret
# VERIFICATION_POLICY_PEER_IDENTITY_KEY_ID=verification-policy-peer-v1
# VERIFICATION_POLICY_PEER_IDENTITY_TTL_SECONDS=10
# VERIFICATION_POLICY_ROLLOUT_MAX_CONCURRENCY=4
